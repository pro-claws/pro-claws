{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/proclaws_be_env/bin/python",
  "python.analysis.include": [
    "backend",
    "hardware",
    "home_page/scripts"
  ],
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/venv",
    "**/proclaws_be_env",
    "**/pro_claws_be_env",
    "**/env_be_vendistri",
    "**/site-packages",
    "**/node_modules",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/target",
    "**/SourcePackages",
    "**/.swift-module-cache",
    "**/.gradle",
    "**/.kotlin",
    "**/.cxx",
    "**/.externalNativeBuild",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "backend/logs",
    "backend/run",
    "backend/media",
    "backend/private_media",
    "backend/private_data",
    "hardware/private_data",
    "hardware/managed_components"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/proclaws_be_env/**": true,
    "**/pro_claws_be_env/**": true,
    "**/env_be_vendistri/**": true,
    "**/__pycache__/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/SourcePackages/**": true,
    "**/.swift-module-cache/**": true,
    "**/.gradle/**": true,
    "**/.kotlin/**": true,
    "**/.cxx/**": true,
    "**/.externalNativeBuild/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "backend/logs/**": true,
    "backend/run/**": true,
    "backend/media/**": true,
    "backend/private_media/**": true,
    "backend/private_data/**": true,
    "hardware/private_data/**": true,
    "hardware/managed_components/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/proclaws_be_env": true,
    "**/pro_claws_be_env": true,
    "**/env_be_vendistri": true,
    "**/__pycache__": true,
    "**/build": true,
    "**/dist": true,
    "**/target": true,
    "**/SourcePackages": true,
    "**/.swift-module-cache": true,
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/.cxx": true,
    "**/.externalNativeBuild": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "backend/logs": true,
    "backend/run": true,
    "backend/media": true,
    "backend/private_media": true,
    "backend/private_data": true,
    "hardware/private_data": true,
    "hardware/managed_components": true
  }
}
